{
  "manifest_version": 3,
  "name": "MatchResumer",
  "version": "1.0.0",
  "description": "Analyzes job descriptions against your resume using AI from a Chrome side panel.",
  "permissions": ["storage", "activeTab", "scripting", "sidePanel"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open MatchResumer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options.html",
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+J",
        "mac": "Command+J"
      },
      "description": "Open the MatchResumer side panel"
    },
    "analyze-resume": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Analyze the current page (Matcher)"
    }
  }
}
